        "services_redeem_not_redeemable": "services.package_not_redeemable"
      },
      "ai": {
        "description": "Consumes one session of a voucher the customer OWNS (a grant, i.e. a purchase); refuses with a domain code the caller can translate — services.package_voided, services.package_no_grant, services.package_not_found, services.package_no_uses_left or services.package_expired — instead of the raw gate error, also when another till or a void commits first. A customer with no grant has nothing to redeem, however many vouchers the catalogue offers."
      },
      "expose_api": true
    },
