{
  "id": "services",
  "name": "Services",
  "version": "1.5.31",
  "description": "Service catalogue with categories and packages, and their availability.",
  "agent": {
    "description": "Manages the service catalogue: create, update and delete services, categories, and service packages; list available services and packages; configure module settings.",
    "keywords": [
      "service",
      "catalogue",
      "category",
      "package",
      "booking",
      "offering",
      "price"
    ]
  },
  "depends_on": [
    "taxes"
  ],
  "permissions": [
    "services.view_service",
    "services.add_service",
    "services.change_service",
    "services.delete_service",
    "services.view_category",
    "services.add_category",
    "services.change_category",
    "services.delete_category",
    "services.view_package",
    "services.add_package",
    "services.change_package",
    "services.delete_package",
    "services.redeem_package",
    "services.view_package_balance",
    "services.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "cashier": [
      "services.view_service",
      "services.view_category",
      "services.view_package",
      "services.view_package_balance",
      "services.redeem_package"
    ],
    "manager": [
      "services.view_service",
      "services.add_service",
      "services.change_service",
      "services.view_category",
      "services.add_category",
      "services.change_category",
      "services.view_package",
      "services.add_package",
      "services.change_package",
      "services.redeem_package",
      "services.view_package_balance"
    ],
    "employee": [
      "services.view_service",
      "services.add_service",
      "services.view_category",
      "services.view_package",
      "services.redeem_package",
      "services.view_package_balance"
    ]
  },
  "navigation": [
    {
      "id": "services",
      "label": "Services",
      "icon": "briefcase",
      "component": "erp-services-list"
    },
    {
      "id": "categories",
      "label": "Categories",
      "icon": "pricetags",
      "component": "erp-services-categories"
    },
    {
      "id": "packages",
      "label": "Packages",
      "icon": "gift",
      "component": "erp-services-packages"
    }
  ],
  "settings": {
    "title": "Servicios",
    "icon": "briefcase-outline",
    "schema": "schemas/settings_update.json",
    "get": "services.settings.get",
    "set": "services.settings.update"
  },
  "setup": {
    "query": "services.catalog.status",
    "configured_when": [
      {
        "field": "sellable_services",
        "truthy": true
      }
    ],
    "title": "Your service catalogue",
    "description": "Add the services you sell, with their price and duration.",
    "icon": "briefcase-outline",
    "route": "/m/services/services",
    "permission": "services.add_service",
    "countries": [],
    "order": 31,
    "required": true
  },
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_tax_rate_id.sql",
      "migrations/postgres/003_package_redemption.sql",
      "migrations/postgres/004_discount_split.sql",
      "migrations/postgres/005_tax_category_key.sql",
      "migrations/postgres/006_quantity_fixed_point.sql",
      "migrations/postgres/007_domain_checks.sql",
      "migrations/postgres/008_discount_basis_points.sql"
    ]
  },
  "queries": {
    "services.services.list": {
      "permission": "services.view_service",
      "sql": "queries/services_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "name",
          "price",
          "pricing_type",
          "duration_minutes",
          "is_bookable",
          "category_id",
          "category",
          "status"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "price": {
            "op": "range"
          },
          "pricing_type": {
            "op": "eq"
          },
          "duration_minutes": {
            "op": "eq"
          },
          "is_bookable": {
            "op": "eq"
          },
          "category_id": {
            "op": "eq"
          },
          "category": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the services available in the catalogue"
      },
      "expose_api": true
    },
    "services.services.get": {
      "permission": "services.view_service",
      "sql": "queries/service_get.sql",
      "schema": "schemas/service_get.json",
      "ai": {
        "description": "Retrieves the full detail of a service by its identifier"
      },
      "expose_api": true
    },
    "services.categories.list": {
      "permission": "services.view_category",
      "sql": "queries/categories_list.sql",
      "list": {
        "search": [
          "name",
          "slug"
        ],
        "sort": [
          "id",
          "name",
          "slug",
          "icon",
          "color",
          "parent_id",
          "sort_order",
          "service_count"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "slug": {
            "op": "eq"
          },
          "icon": {
            "op": "eq"
          },
          "color": {
            "op": "eq"
          },
          "parent_id": {
            "op": "eq"
          },
          "sort_order": {
            "op": "eq"
          },
          "service_count": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the defined service categories"
      },
      "expose_api": true
    },
    "services.categories.get": {
      "permission": "services.view_category",
      "sql": "queries/category_get.sql",
      "schema": "schemas/category_get.json",
      "ai": {
        "description": "Retrieves the full detail of a service category by its identifier"
      },
      "expose_api": true
    },
    "services.packages.list": {
      "permission": "services.view_package",
      "sql": "queries/packages_list.sql",
      "list": {
        "search": [
          "name",
          "slug"
        ],
        "sort": [
          "id",
          "name",
          "slug",
          "discount_type",
          "discount_percent_bp",
          "discount_amount_cents",
          "fixed_price",
          "is_active",
          "items"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "slug": {
            "op": "eq"
          },
          "discount_type": {
            "op": "range"
          },
          "discount_percent_bp": {
            "op": "range"
          },
          "discount_amount_cents": {
            "op": "range"
          },
          "fixed_price": {
            "op": "range"
          },
          "is_active": {
            "op": "eq"
          },
          "items": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the available service packages"
      },
      "expose_api": true
    },
    "services.packages.get": {
      "permission": "services.view_package",
      "sql": "queries/package_get.sql",
      "schema": "schemas/package_get.json",
      "ai": {
        "description": "Retrieves the full detail of a service package by its identifier"
      },
      "expose_api": true
    },
    "services.packages.balance": {
      "permission": "services.view_package_balance",
      "sql": "queries/package_balance.sql",
      "schema": "schemas/package_balance.json",
      "ai": {
        "description": "Returns the remaining uses and validity of a customer's service packages (bonos)"
      },
      "expose_api": true
    },
    "services.packages.redeem_check": {
      "permission": "services.redeem_package",
      "sql": "queries/package_redeem_check.sql",
      "schema": "schemas/package_redeem_check.json",
      "ai": {
        "description": "Checks whether one use of a customer's package (bono) could be redeemed and, if not, returns the business reason (package_not_found, no_uses_left or expired) instead of the raw gate error."
      },
      "expose_api": true
    },
    "services.package_items.list": {
      "permission": "services.view_package",
      "sql": "queries/package_items_list.sql",
      "list": {
        "search": [
          "service_name"
        ],
        "sort": [
          "service_id",
          "quantity",
          "sort_order",
          "service_name",
          "service_price"
        ],
        "default_sort": "service_id",
        "default_dir": "asc",
        "filters": {
          "service_id": {
            "op": "eq"
          },
          "quantity": {
            "op": "range"
          },
          "sort_order": {
            "op": "eq"
          },
          "service_name": {
            "op": "like"
          },
          "service_price": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the individual services included in a package"
      },
      "expose_api": true
    },
    "services.catalog.status": {
      "permission": "services.view_service",
      "sql": "queries/catalog_status.sql",
      "ai": {
        "description": "Reports how many sellable services the catalogue holds; 0 means the catalogue is still empty"
      }
    },
    "services.settings.get": {
      "permission": "services.view_service",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the general settings of the services module"
      }
    }
  },
  "commands": {
    "services.services.create": {
      "permission": "services.add_service",
      "transaction": true,
      "sql": [
        "commands/service_create.sql"
      ],
      "schema": "schemas/service_create.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.category_unavailable",
        "message": "That category is not available: it does not exist in this business or it has been deleted."
      },
      "emit": [
        "services.service.created"
      ],
      "ai": {
        "description": "Creates a new service in the catalogue. The fiscal category (tax_category_key) is mandatory: a service is sold as a sale line with its VAT, so it cannot be created without one."
      },
      "expose_api": true
    },
    "services.services.update": {
      "permission": "services.change_service",
      "transaction": true,
      "sql": [
        "commands/service_update.sql"
      ],
      "schema": "schemas/service_update.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.service_update_rejected",
        "message": "The service could not be updated: it does not exist in this business, or the category you picked does not."
      },
      "emit": [
        "services.service.updated"
      ],
      "ai": {
        "description": "Updates the details of an existing service. The fiscal category (tax_category_key) cannot be emptied."
      },
      "expose_api": true
    },
    "services.services.delete": {
      "permission": "services.delete_service",
      "transaction": true,
      "sql": [
        "commands/service_delete.sql"
      ],
      "schema": "schemas/service_delete.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.service_not_found",
        "message": "That service does not exist in this business."
      },
      "emit": [
        "services.service.deleted"
      ],
      "ai": {
        "description": "Archives a service: it is no longer offered or bookable (soft-delete + is_active = 0). Its history and the appointments already booked (which keep their own name/price/duration snapshot) are kept. Before archiving, ask `appointments.appointments.count_active_for_service` (if appointments is installed) and tell the user how many upcoming appointments still use it."
      }
    },
    "services.services.restore": {
      "permission": "services.change_service",
      "transaction": true,
      "sql": [
        "commands/service_restore.sql"
      ],
      "schema": "schemas/service_restore.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.service_not_archived",
        "message": "That service could not be brought back: it does not exist in this business, or it is already being offered."
      },
      "emit": [
        "services.service.updated"
      ],
      "ai": {
        "description": "Brings an archived service back into the catalogue: it is offered and bookable again (undoes `services.services.delete`). Its name, price, duration and history are untouched — archiving never changed them."
      },
      "expose_api": true
    },
    "services.services.bulk_create": {
      "permission": "services.change_service",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_services"
      },
      "schema": "schemas/services_bulk_create.json",
      "ai": {
        "description": "Creates multiple services in a single bulk operation"
      }
    },
    "services._insert_service": {
      "permission": "services.add_service",
      "sql": [
        "commands/_insert_service.sql"
      ]
    },
    "services.categories.create": {
      "permission": "services.add_category",
      "transaction": true,
      "sql": [
        "commands/category_create.sql"
      ],
      "schema": "schemas/category_create.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.parent_category_unavailable",
        "message": "That parent category is not available: it does not exist in this business or it has been deleted."
      },
      "ai": {
        "description": "Creates a new service category"
      },
      "expose_api": true
    },
    "services.categories.update": {
      "permission": "services.change_category",
      "transaction": true,
      "sql": [
        "commands/category_update.sql"
      ],
      "schema": "schemas/category_update.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.category_update_rejected",
        "message": "The category could not be updated: it does not exist in this business, or the parent you picked does not (or is the category itself)."
      },
      "ai": {
        "description": "Updates the details of an existing service category"
      },
      "expose_api": true
    },
    "services.categories.delete": {
      "permission": "services.delete_category",
      "transaction": true,
      "sql": [
        "commands/category_delete.sql"
      ],
      "schema": "schemas/category_delete.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.category_not_found",
        "message": "That category does not exist in this business."
      },
      "ai": {
        "description": "Deletes a service category (destructive)"
      }
    },
    "services.packages.create": {
      "permission": "services.add_package",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_package"
      },
      "reads": [
        {
          "query": "services.services.list",
          "required": true
        }
      ],
      "schema": "schemas/package_create.json",
      "emit": [
        "services.package.created"
      ],
      "ai": {
        "description": "Creates a new package grouping multiple services together"
      },
      "expose_api": true
    },
    "services.packages.update": {
      "permission": "services.change_package",
      "transaction": true,
      "sql": [
        "commands/package_update.sql"
      ],
      "schema": "schemas/package_update.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.package_not_found",
        "message": "That package does not exist in this business."
      },
      "emit": [
        "services.package.updated"
      ],
      "ai": {
        "description": "Updates the details of an existing service package"
      },
      "expose_api": true
    },
    "services.packages.delete": {
      "permission": "services.delete_package",
      "transaction": true,
      "sql": [
        "commands/package_delete.sql",
        "commands/package_delete_items.sql"
      ],
      "schema": "schemas/package_delete.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.package_not_found",
        "message": "That package does not exist in this business."
      },
      "emit": [
        "services.package.deleted"
      ],
      "ai": {
        "description": "Deletes a service package (destructive)"
      }
    },
    "services.packages.redeem": {
      "permission": "services.redeem_package",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "redeem_package"
      },
      "reads": [
        {
          "query": "services.packages.redeem_check",
          "params": {
            "package_id": "payload.package_id",
            "customer_id": "payload.customer_id"
          },
          "required": true
        }
      ],
      "schema": "schemas/package_redeem.json",
      "emit": [
        "services.package.redeemed"
      ],
      "ai": {
        "description": "Consumes one use of a customer's service package (bono); refuses with a domain code the caller can translate — services.package_no_uses_left, services.package_expired or services.package_not_found — instead of the raw gate error"
      },
      "expose_api": true
    },
    "services._redeem": {
      "permission": "services.redeem_package",
      "sql": [
        "commands/_redeem_insert.sql",
        "commands/_redeem_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "services._insert_package": {
      "permission": "services.add_package",
      "sql": [
        "commands/_insert_package.sql"
      ]
    },
    "services._insert_package_item": {
      "permission": "services.add_package",
      "sql": [
        "commands/_insert_package_item.sql"
      ]
    },
    "services.settings.update": {
      "permission": "services.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "schema": "schemas/settings_update.json",
      "ai": {
        "description": "Updates the general settings of the services module"
      }
    }
  },
  "records": {
    "service": {
      "mutable": true,
      "update": "services.services.update",
      "patch": {
        "read": "services.services.get",
        "key": "service_id"
      }
    },
    "category": {
      "mutable": true,
      "update": "services.categories.update",
      "patch": {
        "read": "services.categories.get",
        "key": "category_id"
      }
    },
    "package": {
      "mutable": true,
      "update": "services.packages.update",
      "patch": {
        "read": "services.packages.get",
        "key": "package_id"
      }
    }
  },
  "events": {
    "listen": {},
    "emits": [
      "services.package.created",
      "services.package.deleted",
      "services.package.redeemed",
      "services.package.updated",
      "services.service.created",
      "services.service.deleted",
      "services.service.updated"
    ]
  },
  "ui": {
    "entry": "dist/services.esm.js"
  }
}
