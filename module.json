{
  "id": "services",
  "name": "Services",
  "version": "1.5.73",
  "description": "Service catalogue with categories and packages, and their availability.",
  "agent": {
    "description": "Manages the service catalogue: create, update and delete services, categories, and service packages; list available services and packages; configure module settings.",
    "keywords": [
      "service",
      "catalogue",
      "category",
      "package",
      "booking",
      "offering",
      "price"
    ]
  },
