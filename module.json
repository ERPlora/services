        "sort": [
          "id",
          "name",
          "slug",
          "icon",
          "color",
          "parent_id",
          "sort_order",
          "service_count"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "slug": {
            "op": "eq"
          },
          "icon": {
            "op": "eq"
          },
          "color": {
            "op": "eq"
          },
          "parent_id": {
            "op": "eq"
          },
          "sort_order": {
            "op": "eq"
          },
          "service_count": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the defined service categories"
      },
      "expose_api": true
    },
    "services.categories.get": {
      "permission": "services.view_category",
      "sql": "queries/category_get.sql",
      "schema": "schemas/category_get.json",
      "ai": {
        "description": "Retrieves the full detail of a service category by its identifier"
      },
      "expose_api": true
    },
    "services.packages.list": {
      "permission": "services.view_package",
      "sql": "queries/packages_list.sql",
      "list": {
        "search": [
          "name",
          "slug"
        ],
        "sort": [
          "id",
          "name",
          "slug",
          "discount_type",
          "discount_percent_bp",
          "discount_amount_cents",
          "fixed_price",
          "is_active",
          "items"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "slug": {
            "op": "eq"
          },
          "discount_type": {
            "op": "range"
          },
          "discount_percent_bp": {
            "op": "range"
          },
          "discount_amount_cents": {
            "op": "range"
          },
          "fixed_price": {
            "op": "range"
          },
          "is_active": {
            "op": "eq"
          },
          "items": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the available service packages"
      },
      "expose_api": true
    },
    "services.packages.get": {
      "permission": "services.view_package",
      "sql": "queries/package_get.sql",
      "schema": "schemas/package_get.json",
      "ai": {
        "description": "Retrieves the full detail of a service package by its identifier"
      },
      "expose_api": true
    },
    "services.packages.balance": {
      "permission": "services.view_package_balance",
      "sql": "queries/package_balance.sql",
      "schema": "schemas/package_balance.json",
      "ai": {
        "description": "Returns the remaining uses and validity of a customer's service packages (bonos)"
      },
      "expose_api": true
    },
    "services.packages.orphans": {
      "permission": "services.view_orphan_grant",
      "sql": "queries/package_orphans.sql",
      "list": {
        "search": [
          "package_name",
          "customer_id"
        ],
        "sort": [
          "customer_deleted_at",
          "granted_at",
          "package_name",
          "amount_cents",
          "remaining",
          "has_value",
          "is_expired"
        ],
        "default_sort": "customer_deleted_at",
        "default_dir": "desc",
        "filters": {
          "has_value": {
            "op": "eq"
          },
          "is_expired": {
            "op": "eq"
          },
          "package_id": {
            "op": "eq"
          },
          "customer_id": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the vouchers (bonos) whose customer was deleted or anonymised, with the sessions and the amount still owed, so they can be refunded or transferred"
      },
      "expose_api": true
    },
    "services.packages.grants": {
      "permission": "services.view_package_balance",
      "sql": "queries/package_grants.sql",
      "schema": "schemas/package_grants.json",
      "list": {
        "search": [
          "customer_id"
        ],
        "sort": [
          "granted_at",
          "customer_id",
          "status",
          "used",
          "remaining",
          "amount_cents",
          "voided_at"
        ],
        "default_sort": "granted_at",
        "default_dir": "desc",
        "filters": {
          "status": {
            "op": "eq"
          },
          "customer_id": {
            "op": "eq"
          },
          "source": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists, one page at a time, the vouchers (bonos) SOLD of one catalogue voucher — one row per customer purchase (grant), live or voided — with the sessions used and left, the expiry, how it was sold and, for a voided one, who voided it, when and why. can_void says whether it can still be voided (nothing spent or held). Filter by status = voided to audit the voids."
      },
      "expose_api": true
    },
    "services.packages.void_check": {
      "permission": "services.void_grant",
      "sql": "queries/package_void_check.sql",
      "schema": "schemas/package_void_check.json",
      "ai": {
        "description": "Checks whether a sold voucher (grant) can be voided and, if not, returns the business reason (grant_not_found, already_voided or in_use) instead of the raw gate error."
      },
      "expose_api": true
    },
    "services.packages.adjust_check": {
      "permission": "services.adjust_grant",
      "sql": "queries/package_adjust_check.sql",
      "schema": "schemas/package_adjust_check.json",
      "ai": {
        "description": "Checks whether a sold voucher (grant) can be given more sessions or a later expiry and, if not, returns the business reason (grant_not_found or already_voided); can_add_uses says it has a session limit and can_extend that it expires."
      },
      "expose_api": true
    },
    "services.packages.redeem_check": {
      "permission": "services.redeem_package",
      "sql": "queries/package_redeem_check.sql",
      "schema": "schemas/package_redeem_check.json",
      "ai": {
        "description": "Checks whether one use of a customer's package (bono) could be redeemed and, if not, returns the business reason (package_not_found, no_uses_left or expired) instead of the raw gate error."
      },
      "expose_api": true
    },
    "services.package_items.list": {
      "permission": "services.view_package",
      "sql": "queries/package_items_list.sql",
      "list": {
        "search": [
          "service_name"
        ],
        "sort": [
          "service_id",
          "quantity",
          "sort_order",
          "service_name",
          "service_price"
        ],
        "default_sort": "service_id",
        "default_dir": "asc",
        "filters": {
          "service_id": {
            "op": "eq"
          },
          "quantity": {
            "op": "range"
          },
          "sort_order": {
            "op": "eq"
          },
          "service_name": {
            "op": "like"
          },
          "service_price": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the individual services included in a package"
      },
      "expose_api": true
    },
    "services.catalog.status": {
      "permission": "services.view_service",
      "sql": "queries/catalog_status.sql",
      "ai": {
        "description": "Reports how many sellable services the catalogue holds; 0 means the catalogue is still empty"
      }
    },
    "services.settings.get": {
      "permission": "services.view_service",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the general settings of the services module"
      }
    },
    "services.packages.refund_check": {
      "permission": "services.view_package_balance",
      "sql": "queries/package_refund_check.sql",
      "schema": "schemas/package_refund_check.json",
      "ai": {
        "description": "Checks whether a PAID voucher session can be given back to its voucher and, if not, returns the business reason (redemption_not_found, already_refunded or not_settled) instead of the raw gate error. It also previews the sessions before and after the return, and WARNS with voucher_expired when the voucher has already expired — a warning, never a refusal: a return undoes a past act and expiry does not veto it."
      },
      "expose_api": true
    },
    "services.packages.redemptions_for_sale": {
      "permission": "services.view_package_balance",
      "sql": "queries/package_redemptions_for_sale.sql",
      "schema": "schemas/package_redemptions_for_sale.json",
      "ai": {
        "description": "Lists the voucher sessions a given SALE spent, so the return screen can give them back. It is services.packages.refund_check by sale: one row per settled redemption — ALWAYS one, including for a session that cannot go back, which carries its business reason (already_refunded, not_settled) instead of disappearing — with the same fields refund_check answers: refundable, reason, already_refunded, the sessions before and after the return, the voucher's expiry and voucher_expired. The order is stable (when the session was taken, then its ordinal on the voucher, then its id), which is what pairs the nth covered line of a service with the nth session that paid for it when the same service appears twice on one ticket. voucher_expired WARNS that the voucher has already expired — never a refusal: a return undoes a past act. A sale that spent no session answers an empty list, never an error."
      },
      "expose_api": true
    },
    "services.packages.redemption_history": {
      "permission": "services.view_package_balance",
      "sql": "queries/package_redemption_history.sql",
      "schema": "schemas/package_redemption_history.json",
      "list": {
        "sort": [
          "movement_seq",
          "redeemed_at",
          "settled_at",
          "use_index",
          "movement",
          "service_name"
        ],
        "default_sort": "movement_seq",
        "default_dir": "desc",
        "filters": {
          "customer_id": {
            "op": "eq"
          },
          "movement": {
            "op": "eq"
          },
          "redeemed_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists, one page at a time, every movement of a voucher — held, consumed, released, expired and refunded — with who did it, when, which sale it belonged to and, for a refund, the return document behind it. Soft-deleted rows are included on purpose: that is where the releases, the expiries and the refunds live, so filtering on movement = refunded is the audit of the sessions a salon gave back. Newest movement first. Filter by customer_id to read one customer's sessions on this voucher, by movement to read one kind of event, and by redeemed_at to cut the ledger by date."
      },
      "expose_api": true
    },
    "services.packages.tender_options": {
      "permission": "services.view_package_balance",
      "sql": "queries/package_tender_options.sql",
      "schema": "schemas/package_tender_options.json",
      "ai": {
        "description": "Lists the vouchers (bonos) this customer can spend on a given service line, already ordered by the tie-break rule, with the preview the till shows before anything is reserved: sessions left now, sessions left AFTER redeeming, the expiry date, how many valid vouchers there were, which one will be spent (is_default) and WHY (default_reason). A voucher covers the line whole or not at all."
      },
      "expose_api": true
    },
    "services.packages.holds_for_checkout": {
      "permission": "services.view_package_balance",
      "sql": "queries/package_holds_for_checkout.sql",
      "schema": "schemas/package_holds_for_checkout.json",
      "ai": {
        "description": "Lists the voucher sessions ALREADY HELD on an open checkout, so a till that reloaded can come back to exactly the state it was in — which voucher covers which line, the counter it was showing, and the redemption_id that undoes it. It returns only what can still be undone: live, held, unsettled holds whose deadline has not passed. A SETTLED session is not listed (the sale was paid and giving it back is a refund, which has its own audited door), and neither is a released or expired one (the session is already back on the voucher). A checkout with no holds answers an empty list, never an error."
      },
      "expose_api": true
    }
  },
  "commands": {
    "services.services.create": {
      "permission": "services.add_service",
      "transaction": true,
      "sql": [
        "commands/service_create.sql"
      ],
      "schema": "schemas/service_create.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.category_unavailable",
        "message": "That category is not available: it does not exist in this business or it has been deleted."
      },
      "emit": [
        "services.service.created"
      ],
      "ai": {
        "description": "Creates a new service in the catalogue. The fiscal category (tax_category_key) is mandatory: a service is sold as a sale line with its VAT, so it cannot be created without one."
      },
      "expose_api": true
    },
    "services.services.update": {
      "permission": "services.change_service",
      "transaction": true,
      "sql": [
        "commands/service_update.sql"
      ],
      "schema": "schemas/service_update.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.service_update_rejected",
        "message": "The service could not be updated: it does not exist in this business, or the category you picked does not."
      },
      "emit": [
        "services.service.updated"
      ],
      "ai": {
        "description": "Updates the details of an existing service. The fiscal category (tax_category_key) cannot be emptied."
      },
      "expose_api": true
    },
    "services.services.delete": {
      "permission": "services.delete_service",
      "transaction": true,
      "sql": [
        "commands/service_delete.sql"
      ],
      "schema": "schemas/service_delete.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.service_not_found",
        "message": "That service does not exist in this business."
      },
      "emit": [
        "services.service.deleted"
      ],
      "ai": {
        "description": "Archives a service: it is no longer offered or bookable (soft-delete + is_active = 0). Its history and the appointments already booked (which keep their own name/price/duration snapshot) are kept. Before archiving, ask `appointments.appointments.count_active_for_service` (if appointments is installed) and tell the user how many upcoming appointments still use it."
      }
    },
    "services.services.restore": {
      "permission": "services.change_service",
      "transaction": true,
      "sql": [
        "commands/service_restore.sql"
      ],
      "schema": "schemas/service_restore.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.service_not_archived",
        "message": "That service could not be brought back: it does not exist in this business, or it is already being offered."
      },
      "emit": [
        "services.service.updated"
      ],
      "ai": {
        "description": "Brings an archived service back into the catalogue: it is offered and bookable again (undoes `services.services.delete`). Its name, price, duration and history are untouched — archiving never changed them."
      },
      "expose_api": true
    },
    "services.services.bulk_create": {
      "permission": "services.change_service",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_services"
      },
      "schema": "schemas/services_bulk_create.json",
      "ai": {
        "description": "Creates multiple services in a single bulk operation"
      }
    },
    "services._insert_service": {
      "permission": "services.add_service",
      "sql": [
        "commands/_insert_service.sql"
      ]
    },
    "services.categories.create": {
      "permission": "services.add_category",
      "transaction": true,
      "sql": [
        "commands/category_create.sql",
        "commands/_category_name_assert.sql"
      ],
      "on_unique": {
        "services_category_name_taken": "services.category_name_taken"
      },
      "schema": "schemas/category_create.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "statement": "commands/category_create.sql",
        "error": "services.parent_category_unavailable",
        "message": "That parent category is not available: it does not exist in this business or it has been deleted."
      },
      "ai": {
        "description": "Creates a new service category"
      },
      "expose_api": true
    },
    "services.categories.update": {
      "permission": "services.change_category",
      "transaction": true,
      "sql": [
        "commands/category_update.sql",
        "commands/_category_name_assert.sql"
      ],
      "on_unique": {
        "services_category_name_taken": "services.category_name_taken"
      },
      "schema": "schemas/category_update.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "statement": "commands/category_update.sql",
        "error": "services.category_update_rejected",
        "message": "The category could not be updated: it does not exist in this business, or the parent you picked does not (or is the category itself)."
      },
      "ai": {
        "description": "Updates the details of an existing service category"
      },
      "expose_api": true
    },
    "services.categories.delete": {
      "permission": "services.delete_category",
      "transaction": true,
      "sql": [
        "commands/category_delete.sql"
      ],
      "schema": "schemas/category_delete.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.category_not_found",
        "message": "That category does not exist in this business."
      },
      "ai": {
