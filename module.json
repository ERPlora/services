    "services.packages.expire_holds": {
      "permission": "services.hold_package",
      "transaction": true,
      "sql": [
        "commands/hold_expire.sql"
      ],
      "schema": "schemas/package_expire_holds.json",
      "emit": [
        "services.package.hold_released"
      ],
      "ai": {
        "description": "Gives back the voucher sessions of checkouts nobody ever came back to: soft-deletes every held session past its deadline and stamps it as expired, so the ledger tells a timeout apart from a cashier's undo. It is the janitor, not the guard — the reads stop counting a hold the moment its deadline passes, and the hold command reclaims stale sessions in its own transaction, so a session comes back even if this task never runs."
      }
    }
  },
