  "queries": {
    "services.services.list": {
      "permission": "services.view_service",
      "sql": "queries/services_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "name",
          "price",
          "pricing_type",
          "duration_minutes",
          "is_bookable",
          "category_id",
          "category",
          "status"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "price": {
            "op": "range"
          },
          "pricing_type": {
            "op": "eq"
          },
          "duration_minutes": {
            "op": "eq"
          },
          "is_bookable": {
            "op": "eq"
          },
          "category_id": {
            "op": "eq"
          },
          "category": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the services available in the catalogue"
      },
      "expose_api": true
    },
    "services.services.get": {
      "permission": "services.view_service",
      "sql": "queries/service_get.sql",
      "schema": "schemas/service_get.json",
