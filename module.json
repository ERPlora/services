    "services.packages.hold_for_line": {
      "permission": "services.hold_package",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "hold_package_for_line"
      },
      "reads": [
        {
          "query": "services.packages.tender_options",
          "params": {
            "customer_id": "payload.customer_id",
            "service_id": "payload.service_id"
          },
          "required": true
        },
        {
          "query": "services.packages.redeem_check",
          "params": {
            "grant_id": "payload.grant_id"
          },
          "required": true
        }
      ],
      "schema": "schemas/package_hold_for_line.json",
      "emit": [
        "services.package.held"
      ],
      "on_unique": {
        "services_redeem_no_grant": "services.package_no_grant",
        "services_redeem_voided": "services.package_voided",
        "services_redeem_package_not_found": "services.package_not_found",
        "services_redeem_no_uses_left": "services.package_no_uses_left",
        "services_redeem_expired": "services.package_expired",
        "services_redeem_does_not_cover_service": "services.package_does_not_cover_service",
        "services_redeem_not_redeemable": "services.package_not_redeemable"
      },
      "ai": {
        "description": "Reserves one session of a voucher the customer OWNS (a grant) to cover one line of the checkout. The session is spent immediately but the redemption stays reversible with services.packages.release_hold until the sale is settled. Refuses with a domain code (services.package_voided, services.package_no_grant, services.package_not_found, services.package_no_uses_left, services.package_expired or services.package_does_not_cover_service) instead of the raw gate error, also when another till or a void commits first. It issues NO fiscal document: a voucher of N sessions is univalent and its record came out when the voucher was SOLD."
      },
      "expose_api": true
    },
    "services.packages.release_hold": {
      "permission": "services.hold_package",
      "transaction": true,
      "sql": [
        "commands/hold_release.sql"
      ],
      "schema": "schemas/package_release_hold.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.hold_not_releasable",
        "message": "That voucher session can no longer be given back: the sale was already paid. Refunding it is a return, and it goes through its own door."
      },
      "emit": [
        "services.package.hold_released"
      ],
      "ai": {
        "description": "Undoes a reserved voucher session while the sale is NOT paid, giving the session back to the voucher. Once the sale is settled it refuses with services.hold_not_releasable."
      },
      "expose_api": true
    },
    "services.packages.settle_hold": {
      "permission": "services.settle_package",
      "transaction": true,
      "sql": [
        "commands/hold_settle.sql"
      ],
      "schema": "schemas/package_settle_hold.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.hold_not_settleable",
        "message": "That voucher session could not be settled: it does not exist here, it was already given back, or it was settled before."
      },
      "emit": [
        "services.package.settled"
      ],
      "ai": {
        "description": "Marks a reserved voucher session as final because the sale was paid. From here it cannot be undone. It issues no fiscal document — the record came out when the voucher was sold (art. 30 ter.1 of Directive 2006/112/CE)."
      },
      "expose_api": true
    },
    "services._hold": {
      "permission": "services.hold_package",
      "sql": [
        "commands/hold_expire.sql",
        "commands/_grant_lock.sql",
        "commands/_hold_insert.sql",
        "commands/_redeem_refusal.sql",
        "commands/_redeem_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "services._settle_holds_for_sale": {
