        "commands/hold_release_on_line_removed.sql"
      ]
    },
    "services.packages.refund_redemption": {
      "permission": "services.refund_package",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "refund_redemption"
      },
      "reads": [
        {
          "query": "services.packages.refund_check",
          "params": {
            "redemption_id": "payload.redemption_id"
          },
          "required": true
        }
      ],
      "schema": "schemas/package_refund_redemption.json",
      "emit": [
        "services.package.refunded"
      ],
      "ai": {
        "description": "Gives a PAID voucher session back to its voucher because the sale was returned, keeping the redemption as an audit trail (who, when, and against which return document). Idempotent by refund_ref: the same document twice returns one session, and a different document over the same redemption is refused with services.redemption_already_refunded. Refuses with a domain code (services.redemption_not_found, services.redemption_not_settled, services.redemption_already_refunded) instead of the raw gate error. An EXPIRED voucher does not block the return — it is recorded and announced. It issues NO fiscal document: the voucher is univalent and its record came out when the voucher was SOLD (art. 30 ter.1 of Directive 2006/112/CE)."
      },
      "expose_api": true
    },
    "services._refund": {
      "permission": "services.refund_package",
      "sql": [
        "commands/_refund_update.sql",
        "commands/_refund_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "services.packages.grant": {
      "permission": "services.grant_package",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "grant_package"
      },
      "reads": [
        {
          "query": "services.packages.get",
          "params": {
            "package_id": "payload.package_id"
          },
          "required": true
        }
      ],
      "schema": "schemas/package_grant.json",
      "emit": [
        "services.package.granted"
      ],
      "ai": {
        "description": "Grants a voucher to a customer: writes the PURCHASE row (who owns which voucher, when, for how much) without which no session can be spent. Snapshots the terms sold — sessions and validity — so a later edit of the catalogue cannot shorten what the customer paid for, and the validity clock starts here, at the purchase. It issues NO fiscal document of its own: a voucher of N sessions is univalent and the record comes out with the SALE that paid for it (art. 30 ter.1 of Directive 2006/112/CE). Use it when the voucher is handed over outside the till; a voucher sold on a ticket is granted automatically when the sale is completed."
      },
      "expose_api": true
    },
    "services._grant": {
      "permission": "services.grant_package",
      "sql": [
        "commands/_grant_insert.sql",
        "commands/_grant_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "services.packages.void_grant": {
      "permission": "services.void_grant",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "void_grant"
      },
      "reads": [
        {
          "query": "services.packages.void_check",
          "params": {
            "grant_id": "payload.grant_id"
          },
          "required": true
        }
      ],
      "schema": "schemas/package_void_grant.json",
      "emit": [
        "services.package.grant_voided"
      ],
      "ai": {
        "description": "Voids a voucher (grant) sold BY MISTAKE — the wrong voucher, the wrong customer, or the same one rung up twice — with a mandatory reason. The grant stops being spendable everywhere and stays as an audit trail (who voided it, when, why). Refused with a domain code when nothing can be voided: services.grant_not_found, services.grant_already_voided, services.grant_in_use (a session was already spent or is held at a till — that is a balance correction, not a void) or services.grant_void_reason_required. It moves NO money: the refund of a paid voucher is the sale's rectifying invoice in sales."
      },
      "expose_api": true
    },
    "services._void_grant": {
      "permission": "services.void_grant",
      "sql": [
        "commands/_grant_lock.sql",
        "commands/_void_grant.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.grant_not_voidable",
        "message": "That voucher could not be voided: it does not exist here, it was already voided, or a session of it was just spent or held.",
        "statement": "commands/_void_grant.sql"
      }
    },
    "services.packages.adjust_grant": {
      "permission": "services.adjust_grant",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "adjust_grant"
      },
      "reads": [
        {
          "query": "services.packages.adjust_check",
          "params": {
            "grant_id": "payload.grant_id"
          },
          "required": true
        }
      ],
      "schema": "schemas/package_adjust_grant.json",
      "emit": [
        "services.package.grant_adjusted"
      ],
      "ai": {
        "description": "Gives a voucher a customer already bought (a grant) more sessions and/or a later expiry, as a courtesy — «one more session on the house», «extended a month because we were closed» — with a mandatory reason. It is written as a movement (who, when, why, how much) that shows in the voucher's movements; the purchase itself is never rewritten. It revives an expired or used-up voucher. A NEGATIVE uses_delta is a balance correction — «a session was spent twice by mistake», «imported with the wrong count» — that takes sessions away, never more than the customer has left. Refused with a domain code: services.grant_not_found, services.grant_already_voided, services.grant_adjust_empty (nothing to move), services.grant_unlimited (sessions on a voucher with no session limit), services.grant_no_expiry (days on a voucher that never expires), services.grant_adjust_below_used (taking away more sessions than are left) or services.grant_adjust_reason_required. It moves NO money and issues no fiscal document: a gifted or corrected session has no consideration."
      },
      "expose_api": true
    },
    "services._adjust_grant": {
      "permission": "services.adjust_grant",
      "sql": [
        "commands/_grant_lock.sql",
        "commands/_adjust_grant.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "services.grant_not_adjustable",
        "message": "That voucher could not be adjusted: it does not exist here, it was voided, its sessions were used in the meantime, or it cannot take what was asked.",
        "statement": "commands/_adjust_grant.sql"
      }
    },
