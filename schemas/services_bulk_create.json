{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "services.services.bulk_create",
  "description": "Payload of the WASM handler `bulk_create_services`: a batch of services, each validated here with the SAME domain rules as `services.services.create` (enum pricing type, non-negative money, duration >= 1, capacity >= 1, flags 0/1, and the mandatory fiscal category). The handler still collects per-item business errors and derives the slug; the id batch is the runtime's. Closed contract (services#9); the fiscal category joined it in services#41, so that a batch no longer produces services that cannot be charged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "services"
  ],
  "properties": {
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tax_category_key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tax_category_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Canonical fiscal category the service taxes by (ADR-0085), one of the `key` values of `taxes.categories.list`. Required per item, exactly as in `services.services.create`: importing a price list without it fills the catalogue with services the till refuses (services#41). `minLength` is not decoration: `required` alone accepts \"\", and \"\" is exactly no category."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "short_description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "category_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "pricing_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "fixed",
              "hourly",
              "from",
              "variable",
              "free",
              null
            ]
          },
          "price": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Minor units of the hub currency (ADR-0007/0123): 1500 = 15,00 € — never the typed-in major unit."
          },
          "cost": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "duration_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "buffer_before": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "buffer_after": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "max_capacity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "is_bookable": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              0,
              1,
              null
            ]
          },
          "requires_confirmation": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              0,
              1,
              null
            ]
          },
          "allow_online_booking": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              0,
              1,
              null
            ]
          },
          "sort_order": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "is_featured": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              0,
              1,
              null
            ]
          },
          "sku": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "barcode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    }
  }
}
