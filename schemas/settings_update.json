{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "services.settings.update",
  "description": "Configuración del módulo services (singleton por hub). La UI envía el snapshot completo (upsert).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default_duration": {
      "type": "integer",
      "title": "Default duration (min)",
      "minimum": 0,
      "default": 60
    },
    "default_buffer_time": {
      "type": "integer",
      "title": "Default buffer time (min)",
      "minimum": 0,
      "default": 0
    },
    "default_tax_category_key": {
      "type": "string",
      "title": "Default VAT rate",
      "default": ""
    },
    "show_prices": {
      "type": "boolean",
      "title": "Show prices",
      "default": true
    },
    "show_duration": {
      "type": "boolean",
      "title": "Show duration",
      "default": true
    },
    "allow_online_booking": {
      "type": "boolean",
      "title": "Allow online booking",
      "default": true
    },
    "include_tax_in_price": {
      "type": "boolean",
      "title": "Prices include VAT",
      "default": true
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "EUR"
    }
  }
}
